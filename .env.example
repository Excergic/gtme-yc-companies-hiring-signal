# ---- required for stages 3 and 5 (the paid Deepline routes) ----
# Copy the value from your local CLI auth:
#   ~/.local/deepline/code-deepline-com/.env
DEEPLINE_API_KEY=

# ---- protects POST /api/run. Without it the trigger endpoint is disabled. ----
APP_TOKEN=generate-a-long-random-string

# ---- schedule: cron expression for the weekly run (default Monday 09:00) ----
SCHEDULE_CRON=0 9 * * 1
TZ=Asia/Kolkata

# ---- spending. 0 = free stages only, paid gate runs as a dry-run. ----
# Turn on only when the Deepline balance is funded.
ALLOW_SPEND=0

# ---- set by the Dockerfile; override only if your volume mounts elsewhere ----
DATA_DIR=/data/data
OUT_DIR=/data/out
